                "x": 14,
                "y": 14,
                "width": 900,
                "height": 24
              },
              "settings": {
                "text": "CAMERA — /camera/color/image_raw/compressed",
                "fontSize": 12,
                "align": "left"
              }
            },
            {
              "id": "camera-view",
              "kind": "camera",
              "title": "Gripper camera",
              "layout": {
                "x": 14,
                "y": 46,
                "width": 512,
                "height": 502
              },
              "settings": {
                "fitMode": "contain",
                "showHeader": true,
                "showStatus": true,
                "source": "ros-topic",
                "streamUrl": "",
                "topic": "/camera/color/image_raw/compressed",
                "webcamPicker": false
              }
            },
            {
              "id": "drive-translation",
              "kind": "joystick",
              "title": "Translation",
              "layout": {
                "x": 542,
                "y": 46,
                "width": 372,
                "height": 372
              },
              "settings": {
                "deadzone": 0,
                "labels": {
                  "top": "▲ Forward",
                  "bottom": "▼ Back",
                  "left": "◀ Left",
                  "right": "Right ▶"
                },
                "mode_id": "both",
                "publish_rate_hz": 30,
                "show_details": false,
                "zero_on_release": true,
                "runtime_binding": {
                  "adapter": "teleop",
