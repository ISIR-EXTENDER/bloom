    "source": "bloom:explorer-camera-test"
  },
  "applications": [
    {
      "id": "explorer-camera-test",
      "name": "Explorer camera test",
      "description": "Drives the arm with a camera in view, to check the camera path end to end before it is added to an operator app.",
      "lifecycle": "active",
      "action_presets": [],
      "runtime_policy": {
        "command_frame_id": "base_link",
        "allowed_message_types": [
          "geometry_msgs/msg/PoseStamped",
          "geometry_msgs/msg/TwistStamped",
          "sensor_msgs/msg/JointState",
          "std_msgs/msg/Float64",
          "std_msgs/msg/Float64MultiArray",
          "std_msgs/msg/String"
        ],
        "allowed_publish_topics": [
          "/explorer_user_interfaces/rqt_armcontrol/max_angular_speed",
          "/explorer_user_interfaces/rqt_armcontrol/max_linear_speed",
          "/gripper_controller/commands",
          "/mode_request"
        ],
        "allowed_recording_topics": [
          "/cartesian_command",
          "/ee_jac",
          "/ee_pose",
          "/ee_velocity",
          "/joint_states",
          "/joint_target_command",
          "/tablet_cartesian_command",
          "/mode_request"
        ],
        "allowed_teleop_targets": [
          "/tablet_cartesian_command"
        ]
      },
      "theme": {
        "inspiration": {
          "moodboard_image_uri": "",
          "reference_url": ""
        },
        "preset_id": "bloom-default",
        "palette": {
          "primary": "#7f967e",
          "accent": "#d9a441",
          "background": "#f7f1e6",
          "surface": "#fffdf7"
        }
      },
      "profiles": [
        {
          "id": "bench",
          "menu_on_tap": true,
          "name": "Bench",
          "display_preset": "default",
          "font_scale": 1,
          "app_theme_preset_id": "bloom-default",
          "preferred_control_layout_id": "camera_test_drive",
          "motor_accessibility_preset": "default",
          "audio_cues": false,
          "deadzone": 0,
          "repeat_guard_ms": 0,
          "scan_period_ms": 1400
        }
      ],
      "screens": [
        {
          "id": "camera_test_drive",
          "title": "Drive with the camera",
          "canvas": {
            "preset_id": "native-1280x720",
            "runtime_mode": "fit"
          },
          "reserved_regions": [
            {
              "id": "stop",
              "owner": "runtime-chrome",
