                  "axis_mapping": {
                    "x": {
                      "component": "linear_y"
                    },
                    "y": {
                      "component": "linear_x",
                      "scale": -1
                    }
                  },
                  "axis_deadzone": 0.2
                }
              }
            },
            {
              "id": "drive-z",
              "kind": "slider",
              "title": "Height",
              "layout": {
                "x": 542,
                "y": 434,
                "width": 372,
                "height": 114
              },
              "settings": {
                "max": 1,
                "min": -1,
                "step": 0.01,
                "value": 0,
                "direction": "horizontal",
                "show_details": false,
                "returnToCenter": true,
                "runtime_binding": {
                  "adapter": "teleop",
                  "target": "linear_z",
                  "axis_mapping": {
                    "value": {
                      "component": "linear_z"
                    }
                  },
                  "value_mapping": {
                    "target_topic": "/tablet_cartesian_command"
                  },
                  "axis_deadzone": 0.2
                }
              }
