{
  "metadata": {
    "schema_version": 1,
    "exported_at": "2026-09-01T16:00:00Z",
    "source": "bloom:explorer-manager"
  },
  "applications": [
    {
      "id": "explorer-manager",
      "name": "Explorer Manager",
      "description": "Operator app shaped around the cartesian_manager branches: velocity drive, named positions, robot feedback, and command-source visibility.",
      "lifecycle": "active",
      "action_presets": [
        {
          "id": "manager-release",
          "name": "Release joint target",
          "kind": "topic-publish",
          "description": "Cancel a running named position and return the manager to passthrough.",
          "command": "behaviour/passthrough",
          "topic": "/mode_request",
          "message_type": "std_msgs/msg/String",
          "payload": {
            "data": "behaviour/passthrough"
          },
          "payload_text": "",
          "tags": [
            "explorer",
            "safety"
          ]
        },
        {
          "id": "manager-neutral",
          "name": "Neutral shaping",
          "kind": "topic-publish",
          "description": "Return the manager to geometric/both.",
          "command": "geometric/both",
          "topic": "/mode_request",
          "message_type": "std_msgs/msg/String",
          "payload": {
            "data": "geometric/both"
          },
          "payload_text": "",
          "tags": [
            "explorer",
            "mode"
          ]
        }
      ],
      "runtime_policy": {
        "allowed_message_types": [
          "geometry_msgs/msg/PoseStamped",
          "geometry_msgs/msg/TwistStamped",
          "sensor_msgs/msg/JointState",
          "std_msgs/msg/Float64",
          "std_msgs/msg/Float64MultiArray",
          "std_msgs/msg/String"
        ],
        "allowed_publish_topics": [
          "/cmd/max_velocity",
          "/gripper_controller/commands",
          "/mode_request"
        ],
        "allowed_recording_topics": [
          "/cartesian_command",
          "/ee_pose",
          "/ee_velocity",
          "/joint_states",
          "/joint_target_command",
          "/joystick_cartesian_command",
          "/mode_request",
          "/visual_servoing_cartesian_command"
        ],
        "allowed_teleop_targets": [
          "/joystick_cartesian_command"
        ]
      },
      "theme": {
        "inspiration": {
          "moodboard_image_uri": "",
          "reference_url": ""
        },
        "preset_id": "bloom-default",
        "palette": {
          "primary": "#7f967e",
          "accent": "#d9a441",
          "background": "#f7f1e6",
          "surface": "#fffdf7"
        }
      },
      "profiles": [],
      "screens": [
        {
          "id": "manager_drive",
          "title": "Drive",
          "canvas": {
            "preset_id": "hd",
            "runtime_mode": "fit"
          },
          "widgets": [
            {
              "id": "drive-translation",
              "kind": "joystick",
              "title": "Translation",
              "layout": {
                "x": 250,
                "y": 250,
                "width": 430,
                "height": 440
              },
              "settings": {
                "axes": {
                  "x": {
                    "color": "#4a9eff",
                    "negative_label": "X-",
                    "positive_label": "X+",
                    "semantic": "translation"
                  },
                  "y": {
                    "color": "#4a9eff",
                    "negative_label": "Y-",
                    "positive_label": "Y+",
                    "semantic": "translation"
                  }
                },
                "deadzone": 0,
                "labels": {
                  "bottom": "Y-",
                  "left": "X-",
                  "right": "X+",
                  "top": "Y+"
                },
                "mode_id": "both",
                "publish_rate_hz": 30,
                "show_details": true,
                "zero_on_release": true,
                "runtime_binding": {
                  "adapter": "teleop",
                  "target": "translation",
                  "value_mapping": {
                    "mode": 0,
                    "target_topic": "/joystick_cartesian_command"
                  },
                  "axis_mapping": {
                    "x": {
                      "component": "linear_x"
                    },
                    "y": {
                      "component": "linear_y"
                    }
                  },
                  "axis_deadzone": 0.2
                }
              }
            },
            {
              "id": "drive-rotation",
              "kind": "joystick",
