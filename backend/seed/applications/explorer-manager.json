              },
              "settings": {
                "axes": {
                  "x": {
                    "color": "#e0685f",
                    "negative_label": "RX-",
                    "positive_label": "RX+",
                    "semantic": "rotation"
                  },
                  "y": {
                    "color": "#e0685f",
                    "negative_label": "RY-",
                    "positive_label": "RY+",
                    "semantic": "rotation"
