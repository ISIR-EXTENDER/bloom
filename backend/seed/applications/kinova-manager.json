  "applications": [
    {
      "id": "kinova-manager",
      "name": "Kinova Manager",
      "description": "Operator app for the Kinova gen3 behind cartesian_manager: velocity drive, named positions, robot feedback, command-source visibility, and fault state.",
      "lifecycle": "active",
      "action_presets": [
        {
          "id": "manager-release",
          "name": "Release joint target",
          "kind": "topic-publish",
          "description": "Cancel a running named position and return the manager to passthrough.",
          "command": "behaviour/passthrough",
          "topic": "/mode_request",
          "message_type": "std_msgs/msg/String",
          "payload": {
            "data": "behaviour/passthrough"
          },
          "payload_text": "",
          "tags": [
            "explorer",
            "safety"
          ]
        },
        {
          "id": "manager-neutral",
          "name": "Neutral shaping",
          "kind": "topic-publish",
          "description": "Return the manager to geometric/both.",
          "command": "geometric/both",
          "topic": "/mode_request",
          "message_type": "std_msgs/msg/String",
          "payload": {
            "data": "geometric/both"
          },
          "payload_text": "",
          "tags": [
            "explorer",
            "mode"
          ]
        },
        {
          "id": "fault-reset",
          "name": "Reset fault",
          "kind": "service-call",
          "description": "Clear the gen3 fault state through the fault controller.",
          "command": "kinova.reset_fault",
          "topic": "/fault_controller/reset_fault",
          "message_type": "example_interfaces/srv/Trigger",
          "payload": null,
          "payload_text": "",
          "tags": [
            "kinova",
            "safety"
          ]
        }
      ],
      "runtime_policy": {
        "command_frame_id": "base_link",
