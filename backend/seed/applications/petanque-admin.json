  "applications": [
    {
      "id": "app-petanque-admin",
      "name": "Petanque admin",
      "description": "Legacy Petanque workflow rebased onto the current stack: teleop through cartesian_manager, match states through apps-petanque's state machine, measure results from the tablet bridge topics. Home screen: default_control.",
      "lifecycle": "active",
      "action_presets": [
        {
          "id": "petanque-activate-throw",
          "name": "Activate throw",
          "kind": "topic-publish",
          "description": "Arm the throwing controller through the Petanque state machine.",
          "command": "activate_throw",
          "topic": "/petanque_state_machine/change_state",
          "message_type": "std_msgs/msg/String",
          "payload": null,
          "payload_text": "{data: 'activate_throw'}",
          "tags": [
            "petanque",
            "state-machine"
          ]
        },
        {
          "id": "petanque-gripper-open",
          "name": "Open gripper",
          "kind": "topic-publish",
          "description": "Open the Explorer gripper through the position controller.",
          "command": "open_gripper",
          "topic": "/gripper_controller/commands",
          "message_type": "std_msgs/msg/Float64MultiArray",
          "payload": {
            "data": [
              0.2
            ]
          },
          "payload_text": "",
          "tags": [
            "petanque",
            "device"
          ]
        }
      ],
      "runtime_policy": {
        "command_frame_id": "base_link",
        "allowed_message_types": [
          "geometry_msgs/msg/TwistStamped",
          "sensor_msgs/msg/JointState",
          "std_msgs/msg/Bool",
          "std_msgs/msg/Float64",
          "std_msgs/msg/Float64MultiArray",
          "std_msgs/msg/String"
        ],
        "allowed_publish_topics": [
          "/explorer_user_interfaces/rqt_armcontrol/max_linear_speed",
          "/gripper_controller/commands",
          "/mode_request",
          "/petanque_state_machine/change_state",
          "/ui/visual_servoing/on",
          "/ui/visual_servoing/save"
        ],
        "allowed_recording_topics": [
          "/ee_pose",
          "/ee_velocity",
          "/joint_states",
          "/joystick_cartesian_command",
          "/mode_request",
          "/petanque/measure/result_vectors",
          "/petanque_state_machine/change_state",
          "/rosout"
        ],
        "allowed_teleop_targets": [
          "/joystick_cartesian_command"
        ],
        "allowed_parameters": [
          "/petanque_throw:alpha",
          "/petanque_throw:total_duration",
          "/petanque_throw:angle_between_start_and_finish"
        ]
      },
