  "applications": [
    {
      "id": "visual-servoing",
      "name": "Visual servoing",
      "description": "Robin's AprilTag flow on the current stack: approach a tag with the gripper camera in view, save the view as the target, then let the visual servoing node drive back to it. Camera on camera_interface's convention topic; the node's frames and the drive axes are the Kinova gen3's today.",
      "lifecycle": "active",
      "runtime_policy": {
        "command_frame_id": "base_link",
        "allowed_message_types": [
          "geometry_msgs/msg/TwistStamped",
          "std_msgs/msg/Bool",
          "std_msgs/msg/Float64",
          "std_msgs/msg/String"
        ],
        "allowed_publish_topics": [
          "/explorer_user_interfaces/rqt_armcontrol/max_angular_speed",
          "/explorer_user_interfaces/rqt_armcontrol/max_linear_speed",
          "/ui/visual_servoing/on",
          "/ui/visual_servoing/save"
        ],
        "allowed_recording_topics": [
          "/ee_pose",
          "/joint_states",
          "/joystick_cartesian_command",
          "/tag_detections",
          "/visual_servoing/error_TAGtoTAGd",
          "/visual_servoing/velocity_command"
        ],
        "allowed_teleop_targets": [
          "/joystick_cartesian_command"
        ],
        "allowed_parameters": [
          "/cartesian_manager:inputs.visual_servoing.enabled"
        ]
      },
      "theme": {
        "inspiration": {
          "moodboard_image_uri": "",
          "reference_url": ""
        },
        "preset_id": "bloom-default",
        "palette": {
          "primary": "#54718e",
          "accent": "#d98841",
          "background": "#f2f4f6",
          "surface": "#fcfdfe"
        }
      },
