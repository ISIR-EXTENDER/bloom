{
  "metadata": {
    "schema_version": 1,
    "exported_at": "2026-09-24T17:00:00Z",
    "source": "bloom:widget-lab"
  },
  "applications": [
    {
      "id": "widget-lab",
      "name": "Widget Lab",
      "description": "Every widget kind on the palette, bound to the simulation's topics, so each one is proven end to end.",
      "lifecycle": "active",
      "action_presets": [],
      "runtime_policy": {
        "command_frame_id": "base_link",
        "allowed_message_types": [
          "geometry_msgs/msg/PoseStamped",
          "geometry_msgs/msg/TwistStamped",
          "sensor_msgs/msg/JointState",
          "std_msgs/msg/Float64",
          "std_msgs/msg/Float64MultiArray",
          "std_msgs/msg/String"
        ],
        "allowed_publish_topics": [
          "/explorer_user_interfaces/rqt_armcontrol/max_angular_speed",
          "/explorer_user_interfaces/rqt_armcontrol/max_linear_speed",
          "/gripper_controller/commands",
          "/mode_request",
          "/ui/widget_lab/gesture"
        ],
        "allowed_recording_topics": [
          "/cartesian_command",
          "/ee_jac",
          "/ee_pose",
          "/ee_velocity",
          "/joint_states",
          "/joint_target_command",
          "/joystick_cartesian_command",
          "/mode_request",
          "/qontrol_explorer/effort_overload"
        ],
        "allowed_teleop_targets": [
          "/joystick_cartesian_command"
        ],
        "allowed_parameters": [
          "/cartesian_manager:shapers.snake.gain"
        ]
      },
      "theme": {
        "inspiration": {
          "moodboard_image_uri": "",
          "reference_url": ""
        },
        "preset_id": "bloom-default",
        "palette": {
          "primary": "#7f967e",
          "accent": "#d9a441",
          "background": "#f7f1e6",
          "surface": "#fffdf7"
        }
      },
      "profiles": [
        {
          "id": "lab",
          "name": "Lab",
          "display_preset": "default",
          "font_scale": 1,
          "app_theme_preset_id": "bloom-default",
          "preferred_control_layout_id": "lab-controls",
          "motor_accessibility_preset": "default",
          "audio_cues": false,
          "deadzone": 0,
          "repeat_guard_ms": 0,
          "scan_period_ms": 1400
        }
      ],
      "screens": [
